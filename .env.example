APP_ENV=production
STORY_DB=/data/stories.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
FACTORY_ADMIN_KEY=
AWS_REGION=eu-west-3
PUBLIC_BASE_URL=https://factory.shahinabdi.com
DAILY_SHORTS_TARGET=4

# Legacy RSS / evergreen topic discovery is disabled for the channel intelligence pivot.
RESEARCH_SCHEDULE_ENABLED=false
RESEARCH_SCHEDULE_HOUR=9
RESEARCH_SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=Europe/Paris

# Google OAuth - never commit real values to Git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://factory.shahinabdi.com/youtube/oauth/callback
YOUTUBE_TOKEN_SECRET_ID=linux-shorts-factory/youtube

# Enable only after OAuth succeeds and IAM permissions are verified.
YOUTUBE_REPORTS_ENABLED=false
YOUTUBE_DAILY_REPORT_HOUR=9
YOUTUBE_WEEKLY_REPORT_DAY=mon
