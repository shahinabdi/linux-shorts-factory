{
  "stories": {
    "9692a4353452": {
      "subject": "Linux Distros",
      "proposed_title": "کدام توزیع لینوکس برای شروع بهتر است؟",
      "script_fa": "اگه تازه می‌خوای لینوکس رو شروع کنی، لازم نیست حتماً بری سراغ آرچ! برای استفاده روزمره، اوبونتو و لینوکس مینت انتخاب‌های ساده‌ای هستن. اگه دوست داری سیستم‌عاملت همیشه به‌روز باشه و با تکنولوژی‌های جدید کار کنی، فدورا گزینه جذابیه. اما اگه می‌خوای کنترل بیشتری روی سیستم داشته باشی و از یادگیری لذت می‌بری، آرچ می‌تونه انتخاب خوبی باشه. پس بهترین توزیع لینوکس وجود نداره؛ بهترین انتخاب، توزیعیه که با نیاز و تجربه تو سازگار باشه.",
      "estimated_seconds": 40,
      "sources": [],
      "editorial_notes": "Evergreen educational content. Beginner-friendly comparison. Verify current installation and support recommendations before publication.",
      "id": "9692a4353452",
      "status": "APPROVED",
      "approval_token": "0fJlXOZa95ixBI-IHPEpHg",
      "revision_notes": null,
      "render_key": null
    }
  },
